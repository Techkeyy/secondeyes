# --- Server only (never exposed to the browser) ---
# Create at https://cloud.near.ai
NEAR_AI_API_KEY=
# Leave unset for the real NEAR AI judge. "synthetic" = TEST JUDGE signed by JUDGE_DEV_KEY (dev contract only).
JUDGE_MODE=
# 32-byte ed25519 seed as 64 hex characters. Only used when JUDGE_MODE=synthetic.
JUDGE_DEV_KEY=
# Cheap model the demo agent uses to read invoices (default z-ai/glm-5.3-flash).
NEAR_AI_READ_MODEL=

# --- Public (inlined into the browser bundle) ---
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=secondeyes-dev.testnet
# Optional. Defaults to a public FastNEAR endpoint for the network.
NEXT_PUBLIC_RPC_URL=
# Where the demo invoices ask to be paid, and where the poisoned invoice tries to redirect payment.
NEXT_PUBLIC_PAYEE_ACME=secondeyes-owner.testnet
NEXT_PUBLIC_PAYEE_ATTACKER=acme-supplies-payments.testnet
